// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AiCompany {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logo             String
  shortDescription String
  description      String

  industry         String
  categories       String // comma-separated or JSON string, SQLite doesn't have native array of strings. We'll use comma-separated string for simplicity
  technologies     String // comma-separated string

  foundedYear      Int?
  location         String
  companyType      String // e.g. Private, Public
  stage            String // e.g. Seed, Series A

  website          String?
  linkedin         String?
  twitter          String?
  github           String?

  featured         Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
